{
  "schemaVersion": 1,
  "tools": [
    {
      "schemaVersion": 1,
      "id": "tool.codec",
      "title": "编码与摘要",
      "route": "/tools/codec/",
      "task": "text-transform",
      "modes": [
        {
          "id": "json-format",
          "label": "JSON 格式化",
          "input": "text",
          "output": "text"
        },
        {
          "id": "hash-sha256",
          "label": "SHA-256",
          "input": "text",
          "output": "text"
        },
        {
          "id": "base64-encode",
          "label": "Base64 编码",
          "input": "text",
          "output": "text"
        },
        {
          "id": "base64-decode",
          "label": "Base64 解码",
          "input": "text",
          "output": "text"
        },
        {
          "id": "url-encode",
          "label": "URL 编码",
          "input": "text",
          "output": "text"
        },
        {
          "id": "url-decode",
          "label": "URL 解码",
          "input": "text",
          "output": "text"
        },
        {
          "id": "unicode-escape",
          "label": "Unicode 转义",
          "input": "text",
          "output": "text"
        },
        {
          "id": "unicode-restore",
          "label": "Unicode 还原",
          "input": "text",
          "output": "text"
        },
        {
          "id": "mdx-source",
          "label": "Markdown / MDX",
          "input": "text",
          "output": "text"
        }
      ],
      "input": {
        "kinds": [
          "text/plain",
          "application/json",
          "text/markdown",
          "text/mdx"
        ],
        "maxBytes": 2097152
      },
      "output": {
        "kinds": [
          "text/plain",
          "application/json"
        ],
        "download": true
      },
      "privacy": {
        "mode": "local-only",
        "uploads": false,
        "thirdPartyProcessing": false
      },
      "offline": {
        "supported": true,
        "requirements": [
          "versioned-runtime-cache",
          "browser-storage"
        ]
      },
      "runtime": {
        "shell": "s3-local-task-runner",
        "worker": true,
        "mainThreadFallback": true
      },
      "accessibility": {
        "staticDescription": true,
        "statusRole": "status",
        "keyboardDropzone": true
      }
    },
    {
      "schemaVersion": 1,
      "id": "tool.markdown-editor",
      "title": "Markdown 编辑器",
      "route": "/tools/markdown/",
      "task": "markdown-editor",
      "modes": [
        "markdown",
        "mdx-source"
      ],
      "input": {
        "kinds": [
          "text/markdown",
          "text/mdx"
        ],
        "maxBytes": 2097152
      },
      "output": {
        "kinds": [
          "text/markdown",
          "text/mdx"
        ],
        "download": true
      },
      "privacy": {
        "mode": "local-only",
        "uploads": false,
        "thirdPartyProcessing": false
      },
      "offline": {
        "supported": true,
        "requirements": [
          "bundled-vditor",
          "browser-storage"
        ]
      },
      "runtime": {
        "shell": "vditor-local-editor",
        "worker": false,
        "mainThreadFallback": true
      },
      "accessibility": {
        "staticDescription": true,
        "statusRole": "status",
        "keyboardDropzone": false
      }
    },
    {
      "schemaVersion": 1,
      "id": "tool.image-compressor",
      "title": "图片压缩",
      "route": "/tools/image-compressor/",
      "task": "image-compress",
      "input": {
        "kinds": [
          "image/jpeg",
          "image/png",
          "image/webp"
        ],
        "maxBytes": 16777216
      },
      "output": {
        "kinds": [
          "image/jpeg",
          "image/png",
          "image/webp"
        ],
        "download": true
      },
      "privacy": {
        "mode": "local-only",
        "uploads": false,
        "thirdPartyProcessing": false
      },
      "offline": {
        "supported": true,
        "requirements": [
          "bundled-compressorjs",
          "browser-storage"
        ]
      },
      "runtime": {
        "shell": "compressorjs-local-adapter",
        "worker": false,
        "mainThreadFallback": true
      },
      "accessibility": {
        "staticDescription": true,
        "statusRole": "status",
        "keyboardDropzone": true
      }
    }
  ]
}
